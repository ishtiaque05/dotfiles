# =========================
# Zsh Configuration
# =========================

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =========================
# PATH
# =========================
# Set up PATH before anything probes for binaries with `command -v` (fzf.zsh,
# zoxide, the eza/bat aliases). `typeset -U` drops duplicate entries, so
# nested shells and re-sourcing don't keep growing PATH.
typeset -U path PATH

{{- if eq .chezmoi.os "darwin" }}

# Homebrew (Apple Silicon first, then Intel). Must come before fzf/zoxide/eza
# are probed, or they silently no-op on a fresh Mac.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{- end }}

# asdf version manager (shims win over system binaries)
path=("${ASDF_DATA_DIR:-$HOME/.asdf}/shims" "$HOME/.asdf/bin" $path)

# ~/.local/bin holds our bat->batcat and fd->fdfind symlinks.
path=("$HOME/.local/bin" $path)

export PATH

# =========================
# Environment
# =========================

if (( $+commands[nvim] )); then
  export EDITOR=nvim
elif (( $+commands[vim] )); then
  export EDITOR=vim
fi
export VISUAL=${EDITOR:-vi}

export BAT_THEME=tokyonight_night

{{- if eq .chezmoi.os "linux" }}

# Directory colors (also feeds completion colors below, so set it first)
(( $+commands[dircolors] )) && eval "$(dircolors -b)"
{{- else if eq .chezmoi.os "darwin" }}

# Directory colors for BSD ls, plus an LS_COLORS equivalent for completion
export LSCOLORS="ExGxBxDxCxEgEdxbxgxcxd"
export CLICOLOR=1
export LS_COLORS="di=1;34:ln=1;36:so=1;31:pi=1;33:ex=1;32:bd=1;34;46:cd=1;34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"
{{- end }}

# =========================
# Prompt (Powerlevel10k)
# =========================

[[ -r ~/powerlevel10k/powerlevel10k.zsh-theme ]] && source ~/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Load Powerlevel10k overrides (custom settings)
[[ -f ~/.p10k-overrides.zsh ]] && source ~/.p10k-overrides.zsh

# =========================
# Shell Options
# =========================

setopt interactive_comments  # allow `# comments` at the prompt
setopt auto_pushd            # cd pushes onto the dir stack (`cd -<TAB>`)
setopt pushd_ignore_dups
setopt pushd_silent
setopt no_beep

# =========================
# Command Line History
# =========================

HISTFILE=$HOME/.zhistory
HISTSIZE=60000               # in memory; kept above SAVEHIST so
SAVEHIST=50000               # hist_expire_dups_first has room to drop dups first

setopt extended_history      # record timestamp and duration
setopt share_history         # share history across running sessions
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_space     # prefix a command with a space to keep it out of history
setopt hist_reduce_blanks
setopt hist_verify           # show !! expansions before running them

# =========================
# Key Bindings
# =========================

# Use emacs keybindings even if EDITOR is vi. Select the keymap *before*
# binding keys: `bindkey -e` switches the main keymap, so bindings made
# earlier would be lost if the default had been viins.
bindkey -e

# Up/Down search history for commands starting with what's already typed.
# Bind both the normal (CSI) and application-mode (SS3) sequences; terminals
# send the latter while zle is active, which the old binding missed.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Ctrl+Left/Right move by word, Home/End/Delete behave as expected
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[H'    beginning-of-line
bindkey '^[[F'    end-of-line
bindkey '^[[3~'   delete-char

# Ctrl+X Ctrl+E edits the current command in $EDITOR
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# =========================
# Zsh Completion System
# =========================

# Rebuild the completion dump at most once a day; otherwise load it without
# the security scan (-C), which is the slow part of compinit.
autoload -Uz compinit
() {
  # $1 is set only if the dump exists and is older than 24h (glob qualifier)
  if (( $# )); then compinit && touch "$1"; else compinit -C; fi
} ${ZDOTDIR:-$HOME}/.zcompdump(N.mh+24)

zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu select=long
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true

zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# =========================
# Load Aliases
# =========================

[[ -f ~/.aliases ]] && source ~/.aliases

# =========================
# Fuzzy Finder (fzf)
# =========================
# Must come after compinit and after PATH (it probes for fd).
[[ -f ~/.config/zsh/fzf.zsh ]] && source ~/.config/zsh/fzf.zsh

# =========================
# Plugins
# =========================

[[ -f ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# Syntax highlighting wraps every ZLE widget that exists when it loads, so it
# has to come after anything that defines widgets (fzf, the bindings above).
[[ -f ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# =========================
# Claude Code terminal state
# =========================
# Claude Code hooks color the tab/pane running it (see claude-term-state).
# If Claude dies without running its SessionEnd hook (crash, kill, dropped
# SSH), clear the leftover color when this shell's prompt comes back. The slot
# names must match the ones in claude-term-state; only a file test runs per
# prompt.
if [[ -x ~/.local/bin/claude-term-state ]]; then
  _claude_term_state_precmd() {
    local slot
    if [[ -n $TMUX && -n $TMUX_PANE ]]; then
      slot=tmux-${TMUX_PANE#%}
    elif [[ $WEZTERM_PANE == <-> ]]; then
      slot=wezterm-$WEZTERM_PANE
    else
      slot=tty-${TTY//\//_}
    fi
    [[ -e ~/.local/state/claude-term-state/$slot ]] &&
      ~/.local/bin/claude-term-state clear </dev/null
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _claude_term_state_precmd
fi

# =========================
# Local overrides
# =========================
# Machine-specific settings and secrets that shouldn't live in the repo.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# =========================
# Zoxide (better cd)
# =========================
# Initialize last so its precmd/chpwd hooks aren't clobbered by later config
# (zoxide warns if anything modifies the shell after its init).
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
  alias cd="z"
fi
